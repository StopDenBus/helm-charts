{
  "enabled": true,
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Mailu image tag (mailuVersion) im mailu Umbrella-Chart",
      "managerFilePatterns": ["/^charts/mailu/values\\.yaml$/"],
      "matchStrings": ["mailuVersion:\\s*\"?(?<currentValue>[\\w.-]+)\"?"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "mailu/admin",
      "packageNameTemplate": "docker.io/mailu/admin",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["charts/mailu/values.yaml"],
      "matchPackageNames": ["docker.io/mailu/admin"],
      "commitMessageTopic": "Mailu images",
      "allowedVersions": "/^\\d{4}\\.\\d{2}\\.\\d+$/",
      "bumpVersions": [
        {
          "name": "mailu umbrella chart version",
          "filePatterns": ["charts/mailu/Chart.yaml"],
          "matchStrings": ["\\nversion:\\s*(?<version>\\S+)"],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchFileNames": ["charts/samba/*"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/malefitz01/samba"],
      "commitMessageTopic": "samba Docker image",
      "commitMessageExtra": "to {{newValue}}"
    },
    {
      "matchFileNames": ["charts/**/*"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "{{parentDir}}",
      "bumpVersion": "patch",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "registryAliases": {
    "dhi.io": "dhi.io"
  }
}
