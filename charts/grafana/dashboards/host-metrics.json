      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(count by (cpu) (node_cpu_seconds_total{instance=~\"$instance\", mode=\"idle\"}))",
          "legendFormat": "",
          "editorMode": "code",
          "range": true
